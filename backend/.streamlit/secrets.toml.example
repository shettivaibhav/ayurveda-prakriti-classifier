# Copy this file to `secrets.toml` (same folder) and fill in real values.
# `secrets.toml` is git-ignored and must never be committed.
#
# The local Python API reads these values from this TOML file.

[supabase]
url = "https://YOUR-PROJECT-ref.supabase.co"
key = "YOUR-SUPABASE-PUBLISHABLE-OR-ANON-KEY"
